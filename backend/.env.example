# Copier ce fichier en ".env" et adapter les valeurs.

# --- Base de données ---
# Par défaut (si absent), l'application utilise un fichier SQLite local (./datalink.db)
# afin de pouvoir démarrer sans dépendance externe pendant le développement.
# Pour brancher la base Supabase (PostgreSQL + PostGIS) définie dans le cahier des
# charges, renseigner la chaîne de connexion fournie par Supabase (Project Settings
# -> Database -> Connection string -> URI), par exemple :
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@<host>:5432/postgres
DATABASE_URL=

# --- CORS ---
# Origines autorisées à appeler l'API (séparées par des virgules).
# Le frontend Vite tourne par défaut sur http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Sécurité API (RNF-03) ---
# Liste de clés API valides, séparées par des virgules. Utilisées par les routes
# protégées (ex. téléchargement en masse). Laisser vide en développement local.
API_KEYS=
# Si True, les routes protégées exigent une clé API valide (header "X-API-Key").
# Mettre à True avant tout déploiement public.
REQUIRE_API_KEY=false

# --- Divers ---
ENVIRONMENT=development

# --- Assistant IA (LangChain + Anthropic Claude) ---
# Clé API Anthropic requise pour le chatbot RAG.
# Obtenir une clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=
