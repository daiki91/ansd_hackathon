# Copie de .env.example, adaptee pour brancher Supabase (PostgreSQL).

# --- Base de donnees ---
# Connexion Supabase construite a partir de composants separes : evite les
# soucis de parsing d'URI quand le mot de passe contient des caracteres
# speciaux (@, /, # ...). sqlalchemy_database_url() (config.py) les assemble
# et encode le mot de passe automatiquement.
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.fennljasavumneiupjyy
DB_PASSWORD=P@sser123Daiki

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=https://datalink-frontend.onrender.com
# --- Securite API (RNF-03) ---
API_KEYS=
REQUIRE_API_KEY=false

# --- Divers ---
ENVIRONMENT=development

# --- Assistant IA (LangChain + Anthropic Claude) ---
ANTHROPIC_API_KEY=

